  m_Script: {fileID: 11500000, guid: d5fe1f462d92e5b4d9d98da893e24d26, type: 3}
  m_Name: Diary
  m_EditorClassIdentifier: Assembly-CSharp::DocumentData
  title: "\uD55C\uC11C\uC9C4\uC758 \uC77C\uAE30\uC7A5"
  body: "\uC0C8 \uD559\uAE30 \uCCAB\uB0A0!\n\n2\uD559\uB144 3\uBC18. \uC544\uB294
    \uC560\uAC00 \uD558\uB098\uB3C4 \uC5C6\uC5B4\uC11C\n\uD558\uB8E8 \uC885\uC77C
    \uCC3D\uBC16\uB9CC \uBD24\uB2E4.\n\n\uADF8\uB7F0\uB370 \uC9DD\uAFCD\uC774 \uB0B4
    \uD544\uD1B5\uC744 \uC8FC\uC6CC \uC8FC\uBA74\uC11C\n\"\uC774\uAC70 \uB108 \uAC70\uC9C0?\"
    \uD558\uACE0 \uC6C3\uC5C8\uB2E4.\n\uC624\uB298\uBD80\uD130 \uC6B0\uB9AC\uB294
    \uCE5C\uAD6C\uB2E4.\n\n\uC78A\uC5B4\uBC84\uB9AC\uC9C0 \uC54A\uAC8C \uC0AC\uBB3C\uD568
    \uBE44\uBC00\uBC88\uD638\uB97C\n\uC6B0\uB9AC\uAC00 \uCC98\uC74C \uAC19\uC740
    \uBC18\uC774 \uB41C \uC624\uB298 \uB0A0\uC9DC\uB85C \uBC14\uAFE8\uB2E4. \uD788\uD788.\n---\n6\uC6D4
    2\uC77C\n\n\uC74C\uC545\uC2E4\uC774 \uD559\uAD50\uC5D0\uC11C \uC81C\uC77C \uC88B\uB2E4.\n\uC544\uBB34\uB3C4
    \uC5C6\uC744 \uB54C \uD53C\uC544\uB178\uB97C \uCE58\uBA74\n\uD559\uAD50 \uC804\uCCB4\uAC00
    \uC870\uC6A9\uD788 \uB0B4 \uB178\uB798\uB97C \uB4E3\uB294 \uAC83 \uAC19\uB2E4.\n\n\uB178\uB798\uB97C
    \uD558\uB098 \uB9CC\uB4E4\uACE0 \uC788\uB2E4.\n\uC55E\uBD80\uBD84\uC740 \uC545\uBCF4\uC5D0
    \uC801\uC5B4\uC11C \uC0AC\uBB3C\uD568\uC5D0 \uB123\uC5B4 \uB450\uACE0,\n\uB4B7\uBD80\uBD84\uC740
    \uC74C\uC545\uC2E4 \uCE60\uD310 \uAD6C\uC11D\uC5D0 \uC801\uC5B4 \uB1A8\uB2E4.\n(\uC9C0\uC6B0\uC9C0
    \uB9C8\uC138\uC694!! \uB77C\uACE0 \uD06C\uAC8C \uC368 \uB460)\n---\n10\uC6D4
    10\uC77C\n\n\uC544\uBE60\uAC00 \uB2E4\uC74C \uC8FC\uC5D0 \uC774\uC0AC \uAC04\uB2E4\uACE0
    \uD588\uB2E4.\n\uC544\uC9C1 \uC544\uBB34\uD55C\uD14C\uB3C4 \uB9D0 \uBABB \uD588\uB2E4.\n\uAC54\uD55C\uD14C\uB3C4.\n---\n10\uC6D4
    16\uC77C\n\n\uB0B4\uC77C \uBC29\uACFC\uD6C4\uC5D0 \uBC29\uC1A1\uC2E4\uC744 \uBE4C\uB838\uB2E4.\n\uAC54\uD55C\uD14C
    \uB178\uB798\uB97C \uB4E4\uB824\uC8FC\uACE0, \uC804\uD559 \uAC04\uB2E4\uACE0
    \uB9D0\uD560 \uAC70\uB2E4.\n\n6\uC2DC \uBC18\uAE4C\uC9C0 \uBC29\uC1A1\uC2E4\uB85C
    \uC624\uB77C\uACE0 \uBB38\uC790 \uBCF4\uB0B4\uC57C\uC9C0.\n\uC548 \uC624\uBA74\u2026
    \uADF8\uB798\uB3C4 \uAE30\uB2E4\uB9B4 \uAC70\uB2E4."
  handwritten: 1
  paperColor: {r: 0.95, g: 0.93, b: 0.86, a: 1}
